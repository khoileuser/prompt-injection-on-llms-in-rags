# HuggingFace token (required for gated models like Llama)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_token_here

# Gemini API key (required for attack successful detection)
# Get your token at: https://aistudio.google.com/api-keys
GEMINI_API_KEY=your_token_here
GEMINI_MODEL=gemini-3-flash-preview

# Device configuration
# Options: auto, cuda, cpu
DEVICE=auto

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Web server configuration
HOST=0.0.0.0
PORT=7860

# Results directory
RESULTS_DIR=./results

# Model cache directory (for HuggingFace models)
# Default: ~/.cache/huggingface
# HF_HOME=/path/to/cache

# Disable telemetry
GRADIO_ANALYTICS_ENABLED=false
